# ---------------------------------------------------------------------------
# Aron Soft — production-oriented defaults. Copy to .env and fill in the blanks.
# ---------------------------------------------------------------------------
APP_NAME="آرون سافت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aron-soft.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session / cache / queue ---------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# On shared hosting without a queue worker keep "sync" (mail is sent inside try/catch).
QUEUE_CONNECTION=sync
CACHE_STORE=database
# CACHE_PREFIX=

# --- Mail (required for order confirmations, newsletter double opt-in) -----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@aron-soft.com"
MAIL_FROM_NAME="${APP_NAME}"

# Inbox that receives contact / order / callback / comment notifications
ADMIN_NOTIFY_EMAIL=info@aron-soft.com

# --- Optional: Telegram alerts for new leads/orders (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_APP_NAME="${APP_NAME}"
